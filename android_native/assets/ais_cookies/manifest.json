{
  "manifest_version": 2,
  "name": "AI Image Studio bridge",
  "version": "1.1",
  "description": "Image to Prompt overlay for the built-in browser, and the Gemini session cookies for AI Image Studio (stays on this device).",
  "browser_specific_settings": {
    "gecko": {
      "id": "ais-cookies@aistudio"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "permissions": [
    "cookies",
    "nativeMessaging",
    "geckoViewAddons",
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end",
      "all_frames": false
    }
  ]
}