<Window x:Class="MHBrowser.InspectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MH Deep Network, Security &amp; UI Inspector" Icon="pack://application:,,,/app.ico"
        Width="1260" Height="780" MinWidth="920" MinHeight="580"
        WindowState="Maximized"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="24"/>
        </Grid.RowDefinitions>

        <!-- ======================= TOP TOOLBAR ======================= -->
        <Border Grid.Row="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderTitle" Text="MH Deep Inspector" Foreground="{StaticResource Accent}" FontSize="14.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <Button x:Name="BtnTabNetwork" Style="{StaticResource AccentButton}" Content="Network / TLS / WS / SSE" Padding="11,5" FontSize="11.5" Click="BtnTabNetwork_Click"/>
                    <Button x:Name="BtnTabUi" Style="{StaticResource FlatButton}" Content="UI Recorder (CSS + XPath)" Padding="11,5" FontSize="11.5" Margin="5,0,0,0" Click="BtnTabUi_Click"/>
                    <Button x:Name="BtnTabInternals" Style="{StaticResource FlatButton}" Content="Security, Storage &amp; Internals" Padding="11,5" FontSize="11.5" Margin="5,0,0,0" Click="BtnTabInternals_Click"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnToggleCapture" Style="{StaticResource GreenButton}" Content="Capturing: ON" Padding="11,5" FontSize="11.5" Click="BtnToggleCapture_Click"/>
                    <Button x:Name="BtnExportHar" Style="{StaticResource FlatButton}" Content="Export HAR 1.2" Padding="10,5" FontSize="11.5" Margin="5,0,0,0" Click="BtnExportHar_Click"/>
                    <Button Style="{StaticResource FlatButton}" Content="Export JSON" Padding="10,5" FontSize="11.5" Margin="5,0,0,0" Click="BtnExportJson_Click"/>
                    <Button x:Name="BtnExportPlaywright" Style="{StaticResource FlatButton}" Content="Playwright (.py)" Padding="10,5" FontSize="11.5" Margin="5,0,0,0" Visibility="Collapsed" Click="BtnExportPlaywright_Click"/>
                    <Button x:Name="BtnExportSelenium" Style="{StaticResource FlatButton}" Content="Selenium (.py)" Padding="10,5" FontSize="11.5" Margin="5,0,0,0" Visibility="Collapsed" Click="BtnExportSelenium_Click"/>
                    <Button Style="{StaticResource FlatButton}" Content="Clear" Padding="10,5" FontSize="11.5" Margin="5,0,0,0" Click="BtnClear_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======================= TAB 1: NETWORK / TLS / WS / SSE / GRAPHQL ======================= -->
        <Grid x:Name="NetworkView" Grid.Row="1" Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtNetFilter" Grid.Column="0" Style="{StaticResource DarkTextBox}" TextChanged="TxtNetFilter_TextChanged" ToolTip="Filter by URL, domain, method, TLS, GraphQL, SSE, WS, or header..."/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                    <Button x:Name="BtnFilterAll" Style="{StaticResource AccentButton}" Content="All" Padding="8,4" FontSize="11" Click="BtnFilter_Click" Tag="ALL"/>
                    <Button x:Name="BtnFilterApi" Style="{StaticResource FlatButton}" Content="API/XHR" Padding="8,4" FontSize="11" Margin="4,0,0,0" Click="BtnFilter_Click" Tag="API"/>
                    <Button x:Name="BtnFilterWs" Style="{StaticResource FlatButton}" Content="WS" Padding="8,4" FontSize="11" Margin="4,0,0,0" Click="BtnFilter_Click" Tag="WS"/>
                    <Button x:Name="BtnFilterSse" Style="{StaticResource FlatButton}" Content="SSE" Padding="8,4" FontSize="11" Margin="4,0,0,0" Click="BtnFilter_Click" Tag="SSE"/>
                    <Button x:Name="BtnFilterGql" Style="{StaticResource FlatButton}" Content="GraphQL" Padding="8,4" FontSize="11" Margin="4,0,0,0" Click="BtnFilter_Click" Tag="GQL"/>
                    <Button x:Name="BtnFilterPost" Style="{StaticResource FlatButton}" Content="POST" Padding="8,4" FontSize="11" Margin="4,0,0,0" Click="BtnFilter_Click" Tag="POST"/>
                    <Button x:Name="BtnFilterCache" Style="{StaticResource FlatButton}" Content="Cache/SW" Padding="8,4" FontSize="11" Margin="4,0,0,0" Click="BtnFilter_Click" Tag="CACHE"/>
                    <Button x:Name="BtnFilterErr" Style="{StaticResource FlatButton}" Content="Errors" Padding="8,4" FontSize="11" Margin="4,0,0,0" Click="BtnFilter_Click" Tag="ERR"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.35*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{StaticResource Panel}" CornerRadius="8,8,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="54"/><ColumnDefinition Width="62"/><ColumnDefinition Width="46"/><ColumnDefinition Width="48"/><ColumnDefinition Width="52"/><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="TIME" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="METHOD" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="STAT" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="SRC" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="PROTO" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="5" Text="MS" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="6" Text="ENDPOINT / GRAPHQL / WS / SSE" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ListBox x:Name="NetList" Grid.Row="1" Background="Transparent" BorderThickness="0" SelectionChanged="NetList_SelectionChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="54"/><ColumnDefinition Width="62"/><ColumnDefinition Width="46"/><ColumnDefinition Width="48"/><ColumnDefinition Width="52"/><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Time}" Foreground="{StaticResource Muted}" FontSize="10.5"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Method}" Foreground="{StaticResource Accent}" FontSize="10.5" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="2" Text="{Binding StatusText}" Foreground="{StaticResource Green}" FontSize="10.5" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="3" Text="{Binding CacheSource}" Foreground="#FF60A5FA" FontSize="10" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="4" Text="{Binding Protocol}" Foreground="{StaticResource Muted}" FontSize="10"/>
                                        <TextBlock Grid.Column="5" Text="{Binding DurationText}" Foreground="{StaticResource Muted}" FontSize="10"/>
                                        <TextBlock Grid.Column="6" Text="{Binding DisplayEndpoint}" Foreground="{StaticResource Text}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="DetailHeader" Grid.Row="0" Text="Select a request to inspect TLS, timing, unredacted headers &amp; body" Foreground="{StaticResource Accent}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Style="{StaticResource FlatButton}" Content="Copy cURL" Padding="8,4" FontSize="11" Click="BtnCopyCurl_Click"/>
                            <Button Style="{StaticResource FlatButton}" Content="Copy Python" Padding="8,4" FontSize="11" Margin="4,0,0,0" Click="BtnCopyPython_Click"/>
                            <Button Style="{StaticResource FlatButton}" Content="Copy Fetch" Padding="8,4" FontSize="11" Margin="4,0,0,0" Click="BtnCopyFetch_Click"/>
                            <Button Style="{StaticResource AccentButton}" Content="Decode JWT / Base64" Padding="8,4" FontSize="11" Margin="6,0,0,0" Click="BtnDecodeTokens_Click"/>
                        </StackPanel>
                        <TextBox x:Name="TxtNetDetail" Grid.Row="2" Style="{StaticResource DarkTextBox}" IsReadOnly="True"
                                 FontFamily="Consolas" FontSize="11.5" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" Padding="10"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ======================= TAB 2: UI ACTION RECORDER (CSS + XPath) ======================= -->
        <Grid x:Name="UiView" Grid.Row="1" Margin="12" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.35*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{StaticResource Panel}" CornerRadius="8,8,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="62"/><ColumnDefinition Width="78"/><ColumnDefinition Width="180"/><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="TIME" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="ACTION" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="CSS SELECTOR" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="XPATH" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="VALUE / TEXT" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ListBox x:Name="UiList" Grid.Row="1" Background="Transparent" BorderThickness="0" SelectionChanged="UiList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="62"/><ColumnDefinition Width="78"/><ColumnDefinition Width="180"/><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Time}" Foreground="{StaticResource Muted}" FontSize="10.5"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Action}" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Selector}" Foreground="{StaticResource Green}" FontFamily="Consolas" FontSize="10.5" TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>
                                    <TextBlock Grid.Column="3" Text="{Binding XPath}" Foreground="#FF60A5FA" FontFamily="Consolas" FontSize="10.5" TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>
                                    <TextBlock Grid.Column="4" Text="{Binding Value}" Foreground="{StaticResource Text}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="UiDetailHeader" Grid.Row="0" Text="Select a recorded UI action to inspect locators" Foreground="{StaticResource Accent}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Style="{StaticResource FlatButton}" Content="Copy CSS" Padding="9,4" FontSize="11" Click="BtnCopyUiCss_Click"/>
                        <Button Style="{StaticResource FlatButton}" Content="Copy XPath" Padding="9,4" FontSize="11" Margin="5,0,0,0" Click="BtnCopyUiXPath_Click"/>
                        <Button Style="{StaticResource FlatButton}" Content="Copy Full XPath" Padding="9,4" FontSize="11" Margin="5,0,0,0" Click="BtnCopyUiFullXPath_Click"/>
                    </StackPanel>
                    <TextBox x:Name="TxtUiDetail" Grid.Row="2" Style="{StaticResource DarkTextBox}" IsReadOnly="True"
                             FontFamily="Consolas" FontSize="11.5" TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" Padding="10"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ======================= TAB 3: SECURITY AUDITS, POSTMESSAGE, STORAGE, BEACON, PORT-SCAN ======================= -->
        <Grid x:Name="InternalsView" Grid.Row="1" Margin="12" Visibility="Collapsed">
            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{StaticResource Panel}" CornerRadius="8,8,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="65"/><ColumnDefinition Width="125"/><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="TIME" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="CATEGORY" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="SOURCE / ORIGIN" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="DETAIL (CSP / CORS / SameSite / postMessage / Storage / Beacon / PortScan)" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ListBox x:Name="InternalsList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="65"/><ColumnDefinition Width="125"/><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Time}" Foreground="{StaticResource Muted}" FontSize="10.5"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Category}" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Source}" Foreground="#FF60A5FA" FontSize="10.5" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Detail}" Foreground="{StaticResource Text}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,0">
            <TextBlock x:Name="InspectorStatus" Text="Live capturing HTTP/TLS/WS/SSE/Audits/Storage/postMessage &amp; UI locators..." Foreground="{StaticResource Muted}" FontSize="10.5" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
