<Window x:Class="MHBrowser.BrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MH Browser" Icon="pack://application:,,,/app.ico"
        Width="1280" Height="820" MinWidth="900" MinHeight="600"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI" KeyDown="Window_KeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="24"/>
        </Grid.RowDefinitions>

        <!-- ======================= TAB BAR ======================= -->
        <Border Grid.Row="0" Background="{StaticResource Bg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Profile Pill Badge -->
                <Border Grid.Column="0" Background="#FF2A240C" BorderBrush="{StaticResource Accent}" BorderThickness="1"
                        CornerRadius="5" Padding="8,3" Margin="0,0,8,0" VerticalAlignment="Center">
                    <TextBlock x:Name="ProfileBadgeText" Text="Profile" Foreground="{StaticResource Accent}" FontSize="11.5" FontWeight="SemiBold"/>
                </Border>

                <!-- Tabs Strip -->
                <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="TabsPanel" Orientation="Horizontal" VerticalAlignment="Center"/>
                </ScrollViewer>

                <!-- New Tab + Info Badges -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <Button Style="{StaticResource FlatButton}" Padding="8,3" Click="BtnNewTab_Click" ToolTip="New Tab (Ctrl+T)">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconPlus}" Fill="{StaticResource Accent}" Width="13" Height="13"/>
                    </Button>
                    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="5" Padding="7,3" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="ProxyBadgeText" Text="Direct" Foreground="{StaticResource Muted}" FontSize="11"/>
                    </Border>
                    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="5" Padding="7,3" Margin="6,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TzBadgeText" Text="TZ: System" Foreground="{StaticResource Green}" FontSize="11"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======================= TOOLBAR ======================= -->
        <Border Grid.Row="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource FlatButton}" Width="32" Height="30" Padding="0" Click="BtnBack_Click" ToolTip="Back">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconBack}" Width="14" Height="14"/>
                    </Button>
                    <Button Style="{StaticResource FlatButton}" Width="32" Height="30" Padding="0" Margin="5,0,0,0" Click="BtnForward_Click" ToolTip="Forward">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconForward}" Width="14" Height="14"/>
                    </Button>
                    <Button Style="{StaticResource FlatButton}" Width="32" Height="30" Padding="0" Margin="5,0,0,0" Click="BtnReload_Click" ToolTip="Reload (F5)">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconReload}" Width="14" Height="14"/>
                    </Button>
                    <Button Style="{StaticResource FlatButton}" Width="32" Height="30" Padding="0" Margin="5,0,0,0" Click="BtnHome_Click" ToolTip="Profile Home">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconHome}" Fill="{StaticResource Accent}" Width="14" Height="14"/>
                    </Button>
                </StackPanel>

                <TextBox x:Name="UrlBox" Grid.Column="1" Style="{StaticResource DarkTextBox}" Margin="10,6"
                         KeyDown="UrlBox_KeyDown" GotKeyboardFocus="UrlBox_GotFocus"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource FlatButton}" Padding="9,5" Click="BtnWebcamTest_Click" ToolTip="Open Webcam Test">
                        <TextBlock Text="Cam Test" FontSize="11.5"/>
                    </Button>
                    <Button Style="{StaticResource FlatButton}" Padding="9,5" Margin="6,0,0,0" Click="BtnWhoer_Click" ToolTip="Check IP, UA &amp; Timezone">
                        <TextBlock Text="Check IP" FontSize="11.5"/>
                    </Button>
                    <Button Style="{StaticResource FlatButton}" Padding="9,5" Margin="6,0,0,0" Click="BtnDevTools_Click" ToolTip="DevTools (F12)">
                        <TextBlock Text="DevTools" FontSize="11.5"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======================= CHROMIUM WEBVIEW HOST ======================= -->
        <Grid x:Name="WebViewHost" Grid.Row="2" Background="#FF000000"/>

        <!-- ======================= STATUS BAR ======================= -->
        <Border Grid.Row="3" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="10,0">
                <TextBlock x:Name="StatusText" Text="Initializing Chromium profile..." FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                <TextBlock x:Name="UaStatusText" Text="" FontSize="11" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center" MaxWidth="460" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>
    </Grid>
</Window>
