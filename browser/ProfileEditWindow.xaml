<Window x:Class="MHBrowser.ProfileEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configure Browser Profile" Icon="pack://application:,,,/app.ico"
        Width="620" Height="640" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,6,0">
                <TextBlock Text="PROFILE DETAILS" Style="{StaticResource SectionLabel}" Margin="0,0,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Profile Name" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtName" Style="{StaticResource DarkTextBox}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Notes / Tag" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtNotes" Style="{StaticResource DarkTextBox}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Start URL" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,10,0,4"/>
                <TextBox x:Name="TxtStartUrl" Style="{StaticResource DarkTextBox}"/>

                <!-- PROXY -->
                <TextBlock Text="PROXY (HTTP / HTTPS / SOCKS5)" Style="{StaticResource SectionLabel}" Margin="0,16,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/><ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="90"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Type" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CbProxyType" Style="{StaticResource DarkCombo}">
                            <ComboBoxItem Content="Direct"/>
                            <ComboBoxItem Content="HTTP"/>
                            <ComboBoxItem Content="HTTPS"/>
                            <ComboBoxItem Content="SOCKS5"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Host / IP" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtProxyHost" Style="{StaticResource DarkTextBox}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Port" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtProxyPort" Style="{StaticResource DarkTextBox}"/>
                    </StackPanel>
                </Grid>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Proxy Username (optional)" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtProxyUser" Style="{StaticResource DarkTextBox}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Proxy Password (optional)" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtProxyPass" Style="{StaticResource DarkTextBox}"/>
                    </StackPanel>
                </Grid>

                <!-- FINGERPRINT & USER AGENT -->
                <TextBlock Text="DEVICE &amp; USER-AGENT (PC / MOBILE / SMART TV / CONSOLE)" Style="{StaticResource SectionLabel}" Margin="0,16,0,6"/>
                <ComboBox x:Name="CbUaPreset" Style="{StaticResource DarkCombo}" SelectionChanged="CbUaPreset_SelectionChanged"/>
                <TextBlock Text="Custom User-Agent String" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,8,0,4"/>
                <TextBox x:Name="TxtUserAgent" Style="{StaticResource DarkTextBox}"/>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Platform" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtPlatform" Style="{StaticResource DarkTextBox}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Language" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtLanguage" Style="{StaticResource DarkTextBox}"/>
                    </StackPanel>
                </Grid>

                <!-- TIMEZONE & PRIVACY -->
                <TextBlock Text="TIMEZONE &amp; ANTIDETECT PROTECTION" Style="{StaticResource SectionLabel}" Margin="0,16,0,6"/>
                <CheckBox x:Name="ChkAutoTz" Content="Auto-sync Timezone from Proxy / VPN IP on launch" Foreground="{StaticResource Text}" FontSize="12.5" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtTimezone" Grid.Column="0" Style="{StaticResource DarkTextBox}" ToolTip="IANA Timezone e.g. America/New_York"/>
                    <Button Grid.Column="2" Style="{StaticResource FlatButton}" Content="Detect IP &amp; TZ" Click="BtnDetectTz_Click"/>
                </Grid>
                <TextBlock x:Name="TzDetectInfo" Text="" Foreground="{StaticResource Green}" FontSize="11.5" Margin="0,5,0,0"/>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,6">
                    <CheckBox x:Name="ChkWebRtc" Content="WebRTC IP Leak Protection" Foreground="{StaticResource Text}" FontSize="12.5" Margin="0,0,18,0"/>
                    <CheckBox x:Name="ChkNoise" Content="Canvas Fingerprint Noise" Foreground="{StaticResource Text}" FontSize="12.5"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Style="{StaticResource AccentButton}" Content="Save Profile" MinWidth="110" Click="BtnSave_Click"/>
            <Button Style="{StaticResource FlatButton}" Content="Cancel" MinWidth="84" Margin="8,0,0,0" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
