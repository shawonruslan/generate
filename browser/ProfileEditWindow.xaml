<Window x:Class="MHBrowser.ProfileEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configure Browser Profile" Icon="pack://application:,,,/app.ico"
        Width="700" Height="740" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="PROFILE DETAILS" Style="{StaticResource SectionLabel}" Margin="0,0,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/><ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="0.9*"/><ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="1.2*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Profile Name" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtName" Style="{StaticResource DarkTextBox}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Group / Folder" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtGroup" Style="{StaticResource DarkTextBox}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Notes / Tag" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtNotes" Style="{StaticResource DarkTextBox}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Start URL" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,10,0,4"/>
                <TextBox x:Name="TxtStartUrl" Style="{StaticResource DarkTextBox}"/>

                <!-- CONNECTION: PROXY OR OPENVPN / WIREGUARD -->
                <TextBlock Text="CONNECTION (PROXY / OPENVPN .ovpn / WIREGUARD .conf)" Style="{StaticResource SectionLabel}" Margin="0,16,0,6"/>

                <!-- Quick Assign from Saved Proxy Manager -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Saved Proxy:" Foreground="{StaticResource Muted}" FontSize="11.5" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CbSavedProxies" Grid.Column="2" Style="{StaticResource DarkCombo}" SelectionChanged="CbSavedProxies_SelectionChanged"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="165"/><ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="85"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Connection Type" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CbProxyType" Style="{StaticResource DarkCombo}" SelectionChanged="CbProxyType_SelectionChanged">
                            <ComboBoxItem Content="Direct"/>
                            <ComboBoxItem Content="HTTP"/>
                            <ComboBoxItem Content="HTTPS"/>
                            <ComboBoxItem Content="SOCKS5"/>
                            <ComboBoxItem Content="OpenVPN (.ovpn)"/>
                            <ComboBoxItem Content="WireGuard (.conf)"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Proxy Host / IP" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtProxyHost" Style="{StaticResource DarkTextBox}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Port" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtProxyPort" Style="{StaticResource DarkTextBox}"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Proxy Username (optional)" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtProxyUser" Style="{StaticResource DarkTextBox}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Proxy Password (optional)" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtProxyPass" Style="{StaticResource DarkTextBox}"/>
                    </StackPanel>
                </Grid>

                <StackPanel Margin="0,10,0,0">
                    <TextBlock Text="OpenVPN (.ovpn) / WireGuard (.conf) Config File (isolated per profile)" Foreground="{StaticResource Accent}" FontSize="11.5" Margin="0,0,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtVpnConfig" Grid.Column="0" Style="{StaticResource DarkTextBox}"/>
                        <Button Grid.Column="2" Style="{StaticResource FlatButton}" Content="Browse .ovpn / .conf" Click="BtnBrowseVpn_Click"/>
                    </Grid>
                </StackPanel>

                <!-- DEVICE & ADVANCED FINGERPRINT SPOOFING -->
                <Grid Margin="0,16,0,6">
                    <TextBlock Text="DEVICE &amp; ADVANCED FINGERPRINT SPOOFING" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource AccentButton}" Content="New Fingerprint" Padding="10,4" FontSize="11.5" HorizontalAlignment="Right" Click="BtnNewFingerprint_Click"/>
                </Grid>
                <ComboBox x:Name="CbUaPreset" Style="{StaticResource DarkCombo}" SelectionChanged="CbUaPreset_SelectionChanged"/>
                <TextBlock Text="Custom User-Agent String" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,8,0,4"/>
                <TextBox x:Name="TxtUserAgent" Style="{StaticResource DarkTextBox}"/>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="80"/><ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Platform" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtPlatform" Style="{StaticResource DarkTextBox}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Language" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtLanguage" Style="{StaticResource DarkTextBox}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Screen W" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtScreenW" Style="{StaticResource DarkTextBox}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="6">
                        <TextBlock Text="Screen H" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtScreenH" Style="{StaticResource DarkTextBox}"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="WebGL Vendor" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtWebGlVendor" Style="{StaticResource DarkTextBox}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="WebGL Renderer (GPU Spoof)" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtWebGlRenderer" Style="{StaticResource DarkTextBox}"/>
                    </StackPanel>
                </Grid>

                <!-- TIMEZONE, GEOLOCATION & DEEP ANTIDETECT LAYERS -->
                <TextBlock Text="TIMEZONE, GEOLOCATION &amp; DEEP ANTIDETECT PROTECTION" Style="{StaticResource SectionLabel}" Margin="0,16,0,6"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <CheckBox x:Name="ChkAutoTz" Content="Auto-sync Timezone from IP" Foreground="{StaticResource Text}" FontSize="12" Margin="0,0,18,0"/>
                    <CheckBox x:Name="ChkAutoGeo" Content="Auto-sync Geolocation from IP" Foreground="{StaticResource Text}" FontSize="12"/>
                </StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtTimezone" Grid.Column="0" Style="{StaticResource DarkTextBox}" ToolTip="IANA Timezone e.g. America/New_York"/>
                    <Button Grid.Column="2" Style="{StaticResource FlatButton}" Content="Detect IP &amp; TZ" Click="BtnDetectTz_Click"/>
                </Grid>
                <TextBlock x:Name="TzDetectInfo" Text="" Foreground="{StaticResource Green}" FontSize="11.5" Margin="0,5,0,0"/>

                <!-- CUSTOM SPOOFED LOCATION (GPS) -->
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.6*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="0.7*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Spoofed Location Preset" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,3"/>
                        <ComboBox x:Name="CbGeoPreset" Style="{StaticResource DarkCombo}" SelectionChanged="CbGeoPreset_SelectionChanged"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Latitude" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,3"/>
                        <TextBox x:Name="TxtGeoLat" Style="{StaticResource DarkTextBox}" ToolTip="e.g. 40.7128"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Longitude" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,3"/>
                        <TextBox x:Name="TxtGeoLon" Style="{StaticResource DarkTextBox}" ToolTip="e.g. -74.0060"/>
                    </StackPanel>
                    <StackPanel Grid.Column="6">
                        <TextBlock Text="Accuracy (m)" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,3"/>
                        <TextBox x:Name="TxtGeoAcc" Style="{StaticResource DarkTextBox}" ToolTip="GPS accuracy in meters (e.g. 35)"/>
                    </StackPanel>
                </Grid>

                <UniformGrid Columns="2" Margin="0,10,0,6">
                    <CheckBox x:Name="ChkWebRtc" Content="WebRTC IP Leak Protection" Foreground="{StaticResource Text}" FontSize="12" Margin="0,0,0,6"/>
                    <CheckBox x:Name="ChkWebRtcSpoof" Content="WebRTC Public IP Spoof (Exit IP)" Foreground="{StaticResource Text}" FontSize="12" Margin="0,0,0,6"/>
                    <CheckBox x:Name="ChkNoise" Content="Canvas Fingerprint Noise" Foreground="{StaticResource Text}" FontSize="12" Margin="0,0,0,6"/>
                    <CheckBox x:Name="ChkWebGl" Content="WebGL Vendor/GPU Spoofing" Foreground="{StaticResource Text}" FontSize="12" Margin="0,0,0,6"/>
                    <CheckBox x:Name="ChkAudio" Content="AudioContext Fingerprint Noise" Foreground="{StaticResource Text}" FontSize="12" Margin="0,0,0,6"/>
                    <CheckBox x:Name="ChkClientRects" Content="ClientRects (DOMRect) Noise" Foreground="{StaticResource Text}" FontSize="12" Margin="0,0,0,6"/>
                    <CheckBox x:Name="ChkFonts" Content="Font Fingerprint Masking" Foreground="{StaticResource Text}" FontSize="12" Margin="0,0,0,6"/>
                    <CheckBox x:Name="ChkMedia" Content="Media Devices ID Spoofing" Foreground="{StaticResource Text}" FontSize="12" Margin="0,0,0,6"/>
                    <CheckBox x:Name="ChkBatteryNet" Content="Battery &amp; Network Info Spoof" Foreground="{StaticResource Text}" FontSize="12"/>
                    <CheckBox x:Name="ChkSpeechPlugins" Content="Speech Voices &amp; Plugins Mask" Foreground="{StaticResource Text}" FontSize="12"/>
                </UniformGrid>

                <!-- CHROME EXTENSIONS (.zip / .crx / Unpacked) -->
                <Grid Margin="0,16,0,6">
                    <TextBlock Text="CHROME EXTENSIONS (.zip / .crx / Unpacked Folder)" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource FlatButton}" Content="+ Upload .zip / .crx" Padding="9,4" FontSize="11.5" Click="BtnAddExtZip_Click"/>
                        <Button Style="{StaticResource FlatButton}" Content="+ Folder" Padding="9,4" FontSize="11.5" Margin="6,0,0,0" Click="BtnAddExtFolder_Click"/>
                    </StackPanel>
                </Grid>
                <ListBox x:Name="ExtensionsList" Height="88" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding}" Foreground="{StaticResource Text}" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="1" Style="{StaticResource ToolbarIconButton}" Width="22" Height="22" Content="&#x2715;" FontSize="10" Click="BtnRemoveExt_Click" Tag="{Binding}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Style="{StaticResource AccentButton}" Content="Save Profile" MinWidth="115" Click="BtnSave_Click"/>
            <Button Style="{StaticResource FlatButton}" Content="Cancel" MinWidth="84" Margin="8,0,0,0" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
