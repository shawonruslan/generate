<Window x:Class="MHBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MH Advanced Tool" Icon="pack://application:,,,/app.ico"
        Width="1280" Height="780" WindowState="Maximized" MinWidth="980" MinHeight="620"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="Segoe UI">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ======================= LEFT SIDEBAR ======================= -->
        <Border Grid.Column="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,16">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="4,0,0,20">
                        <Border Width="34" Height="34" CornerRadius="8" Background="#FF24200E" BorderBrush="{StaticResource Accent}" BorderThickness="1">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconGrid}" Fill="{StaticResource Accent}" Width="17" Height="17"/>
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="MH Advanced Tool" Foreground="{StaticResource Text}" FontSize="14.5" FontWeight="SemiBold"/>
                            <TextBlock Text="Pro Suite v4.4" Foreground="{StaticResource Muted}" FontSize="10.5"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="WORKSPACE" Style="{StaticResource SectionLabel}" Margin="8,0,0,6"/>

                    <Button x:Name="NavApps" Style="{StaticResource NavButton}" Background="{StaticResource Panel}" Click="NavApps_Click" Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconGrid}" Fill="{StaticResource Accent}" Width="15" Height="15"/>
                            <TextBlock Text="Applications" Foreground="{StaticResource Text}" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="NavProfiles" Style="{StaticResource NavButton}" Click="NavProfiles_Click" Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconUsers}" Width="15" Height="15"/>
                            <TextBlock Text="Browser Profiles" Foreground="{StaticResource Text}" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="NavProxies" Style="{StaticResource NavButton}" Click="NavProxies_Click" Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconGlobe}" Width="15" Height="15"/>
                            <TextBlock Text="Proxy Manager" Foreground="{StaticResource Text}" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="NavVpn" Style="{StaticResource NavButton}" Click="NavVpn_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconShield}" Width="15" Height="15"/>
                            <TextBlock Text="VPN (OpenVPN / WG)" Foreground="{StaticResource Text}" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="NavCloud" Style="{StaticResource NavButton}" Click="NavCloud_Click" Margin="0,4,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconLock}" Fill="{StaticResource Accent}" Width="15" Height="15"/>
                            <TextBlock Text="Cloud Sync (R2)" Foreground="{StaticResource Text}" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Background="{StaticResource Panel}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <TextBlock Text="SUITE STATUS" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold"/>
                        <TextBlock Text="Chromium + VirtualCam" Foreground="{StaticResource Green}" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0"/>
                        <TextBlock x:Name="SidebarCountText" Text="0 Profiles" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <Grid/>
            </DockPanel>
        </Border>

        <!-- ======================= MAIN CONTENT ======================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="28"/>
            </Grid.RowDefinitions>

            <!-- Top Bar -->
            <Border Grid.Row="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="22,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PageTitleText" Grid.Column="0" Text="Applications" Foreground="{StaticResource Text}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CbGroupFilter" Grid.Column="1" Style="{StaticResource DarkCombo}" Width="150"
                              HorizontalAlignment="Right" Margin="0,0,10,0" SelectionChanged="CbGroupFilter_SelectionChanged" Visibility="Collapsed"/>
                    <TextBox x:Name="SearchBox" Grid.Column="2" Style="{StaticResource DarkTextBox}" Width="220" Height="32"
                             Margin="0,0,10,0" TextChanged="SearchBox_TextChanged" Visibility="Collapsed" ToolTip="Search profiles..."/>
                    <StackPanel x:Name="ProfileTopActions" Grid.Column="3" Orientation="Horizontal" Visibility="Collapsed" VerticalAlignment="Center">
                        <Button Style="{StaticResource FlatButton}" Content="Tile Grid" Padding="10,6" FontSize="12" Margin="0,0,8,0" Click="BtnTileAll_Click" ToolTip="Arrange all open browser windows in a neat grid"/>
                        <Button Style="{StaticResource FlatButton}" Content="Import .mhprofile" Padding="10,6" FontSize="12" Margin="0,0,8,0" Click="BtnImportProfile_Click" ToolTip="Import encrypted .mhprofile backup"/>
                        <Button x:Name="BtnCreateProfile" Style="{StaticResource AccentButton}" Click="BtnCreateProfile_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource IconPath}" Data="{StaticResource IconPlus}" Fill="#FF111111" Width="13" Height="13"/>
                                <TextBlock Text="New Profile" Foreground="#FF111111" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ======================= APPLICATIONS GRID VIEW ======================= -->
            <ScrollViewer x:Name="AppsView" Grid.Row="1" Margin="24,20" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Select a tool below to launch. All modules run locally with isolated configurations."
                               Foreground="{StaticResource Muted}" FontSize="12.5" Margin="0,0,0,16"/>

                    <UniformGrid Columns="2" HorizontalAlignment="Stretch">
                        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,14,14">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top">
                                    <Grid>
                                        <Border Width="42" Height="42" CornerRadius="9" Background="#FF24200E" BorderBrush="{StaticResource Accent}" BorderThickness="1" HorizontalAlignment="Left">
                                            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconVideoCam}" Fill="{StaticResource Accent}" Width="20" Height="20"/>
                                        </Border>
                                        <Border Background="#FF112A22" BorderBrush="{StaticResource Green}" BorderThickness="1" CornerRadius="4" Padding="7,2" HorizontalAlignment="Right" VerticalAlignment="Top">
                                            <TextBlock Text="HD USB WEBCAM" Foreground="{StaticResource Green}" FontSize="10" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="MH Virtual Camera" Foreground="{StaticResource Text}" FontSize="16" FontWeight="SemiBold" Margin="0,14,0,6"/>
                                    <TextBlock Text="Virtual webcam engine for DirectShow &amp; Windows 11 Media Foundation with 3D Dolly Zoom, slow/fast speed, clip splitter, audio sync, and custom global shortcuts."
                                               Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" LineHeight="18"/>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,18,0,0">
                                    <Button Style="{StaticResource AccentButton}" Content="Open Virtual Camera" Padding="14,7" Click="BtnLaunchVirtualCam_Click"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,14">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top">
                                    <Grid>
                                        <Border Width="42" Height="42" CornerRadius="9" Background="#FF122620" BorderBrush="{StaticResource Green}" BorderThickness="1" HorizontalAlignment="Left">
                                            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconUsers}" Fill="{StaticResource Green}" Width="20" Height="20"/>
                                        </Border>
                                        <Border Background="{StaticResource PanelAlt}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="7,2" HorizontalAlignment="Right" VerticalAlignment="Top">
                                            <TextBlock Text="10-LAYER ANTIDETECT" Foreground="{StaticResource Text}" FontSize="10" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="Antidetect Browser Profiles" Foreground="{StaticResource Text}" FontSize="16" FontWeight="SemiBold" Margin="0,14,0,6"/>
                                    <TextBlock Text="Isolated multi-account Chromium profiles with WebGL, Canvas, Audio, ClientRects, Font &amp; WebRTC spoofing, Chrome Extensions (.zip/.crx), Cookies &amp; Session Restore."
                                               Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" LineHeight="18"/>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,18,0,0">
                                    <Button Style="{StaticResource GreenButton}" Content="Manage Profiles" Padding="14,7" Click="NavProfiles_Click"/>
                                    <Button Style="{StaticResource FlatButton}" Content="+ New Profile" Padding="12,7" Margin="8,0,0,0" Click="BtnCreateProfile_Click"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,14,0">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top">
                                    <Grid>
                                        <Border Width="42" Height="42" CornerRadius="9" Background="#FF1C2331" BorderBrush="#FF3B82F6" BorderThickness="1" HorizontalAlignment="Left">
                                            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconGlobe}" Fill="#FF60A5FA" Width="20" Height="20"/>
                                        </Border>
                                        <Border Background="{StaticResource PanelAlt}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="7,2" HorizontalAlignment="Right" VerticalAlignment="Top">
                                            <TextBlock Text="BULK PROXY CHECKER" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="Proxy Manager &amp; Checker" Foreground="{StaticResource Text}" FontSize="16" FontWeight="SemiBold" Margin="0,14,0,6"/>
                                    <TextBlock Text="Bulk import HTTP, HTTPS &amp; authenticated SOCKS5 proxies, verify live speed, country &amp; timezone in 1 click, and assign directly to profiles."
                                               Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" LineHeight="18"/>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,18,0,0">
                                    <Button Style="{StaticResource FlatButton}" Content="Open Proxy Manager" Padding="14,7" Click="NavProxies_Click"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top">
                                    <Grid>
                                        <Border Width="42" Height="42" CornerRadius="9" Background="#FF24200E" BorderBrush="{StaticResource Accent}" BorderThickness="1" HorizontalAlignment="Left">
                                            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconShield}" Fill="{StaticResource Accent}" Width="20" Height="20"/>
                                        </Border>
                                        <Border Background="{StaticResource PanelAlt}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="7,2" HorizontalAlignment="Right" VerticalAlignment="Top">
                                            <TextBlock Text="ISOLATED PER-PROFILE" Foreground="{StaticResource Accent}" FontSize="10" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="Built-in VPN &amp; Quick Launch" Foreground="{StaticResource Text}" FontSize="16" FontWeight="SemiBold" Margin="0,14,0,6"/>
                                    <TextBlock Text="Silent per-profile OpenVPN (.ovpn) and userspace WireGuard (.conf) tunnels without changing your PC IP, or launch your default browser immediately."
                                               Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" LineHeight="18"/>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,18,0,0">
                                    <Button Style="{StaticResource AccentButton}" Content="Quick Launch Browser" Padding="14,7" Click="BtnQuickLaunchBrowser_Click"/>
                                    <Button Style="{StaticResource FlatButton}" Content="VPN Tools" Padding="12,7" Margin="8,0,0,0" Click="NavVpn_Click"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </ScrollViewer>

            <!-- ======================= PROFILES VIEW ======================= -->
            <Grid x:Name="ProfilesView" Grid.Row="1" Margin="20,16" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6,6,0,0" Padding="14,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.1*"/>
                            <ColumnDefinition Width="0.8*"/>
                            <ColumnDefinition Width="1.6*"/>
                            <ColumnDefinition Width="1.6*"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="275"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="PROFILE NAME &amp; GROUP" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="STATUS" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="PROXY / VPN" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="DEVICE / USER-AGENT" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="4" Text="TIMEZONE" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="5" Text="ACTIONS" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </Grid>
                </Border>

                <ListBox x:Name="ProfilesList" Grid.Row="1" Background="{StaticResource Surface}" Foreground="{StaticResource Text}"
                         BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,1,1"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         HorizontalContentAlignment="Stretch" Padding="0">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="RowBd" Background="Transparent" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,10">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="RowBd" Property="Background" Value="{StaticResource Panel}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.1*"/>
                                    <ColumnDefinition Width="0.8*"/>
                                    <ColumnDefinition Width="1.6*"/>
                                    <ColumnDefinition Width="1.6*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="275"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource Text}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <Border Background="#FF24200E" BorderBrush="{StaticResource Accent}" BorderThickness="1" CornerRadius="3" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Group}" Foreground="{StaticResource Accent}" FontSize="9.5" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Notes}" Foreground="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Border Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{StaticResource PanelAlt}" CornerRadius="4" Padding="7,3">
                                    <TextBlock Text="{Binding StatusLabel}" Foreground="{StaticResource Green}" FontSize="10.5" FontWeight="SemiBold"/>
                                </Border>
                                <TextBlock Grid.Column="2" Text="{Binding ProxySummary}" Foreground="{StaticResource Text}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="3" Text="{Binding DeviceSummary}" Foreground="{StaticResource Muted}" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="4" Text="{Binding TimezoneSummary}" Foreground="{StaticResource Accent}" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Style="{StaticResource GreenButton}" Padding="11,5" FontSize="12" Content="Run" Click="BtnRunProfile_Click" Tag="{Binding}"/>
                                    <Button Style="{StaticResource FlatButton}" Padding="9,5" FontSize="12" Margin="6,0,0,0" Content="Edit" Click="BtnEditProfile_Click" Tag="{Binding}"/>
                                    <Button Style="{StaticResource FlatButton}" Padding="8,5" FontSize="11.5" Margin="5,0,0,0" Content="Clone" Click="BtnCloneProfile_Click" Tag="{Binding}"/>
                                    <Button Style="{StaticResource FlatButton}" Padding="8,5" FontSize="11.5" Margin="5,0,0,0" Content="Export" Click="BtnExportProfile_Click" Tag="{Binding}" ToolTip="Export AES-256 encrypted .mhprofile"/>
                                    <Button Style="{StaticResource FlatButton}" Padding="8,5" FontSize="11.5" Margin="5,0,0,0" Content="Del" Click="BtnDeleteProfile_Click" Tag="{Binding}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- ======================= PROXY MANAGER & BULK CHECKER VIEW ======================= -->
            <Grid x:Name="ProxiesView" Grid.Row="1" Margin="20,16" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="295"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="BULK IMPORT PROXIES (host:port:user:pass  OR  socks5://user:pass@host:port)" Style="{StaticResource SectionLabel}" Margin="0,0,0,6"/>
                            <TextBox x:Name="TxtBulkProxies" Style="{StaticResource DarkTextBox}" Height="68" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="8"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                            <ComboBox x:Name="CbBulkProxyType" Style="{StaticResource DarkCombo}" SelectedIndex="0" Margin="0,0,0,6">
                                <ComboBoxItem Content="SOCKS5"/>
                                <ComboBoxItem Content="HTTP"/>
                                <ComboBoxItem Content="HTTPS"/>
                            </ComboBox>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource AccentButton}" Content="Import" Padding="12,6" Click="BtnImportProxies_Click"/>
                                <Button Style="{StaticResource GreenButton}" Content="Check All" Padding="12,6" Margin="6,0,0,0" Click="BtnCheckAllProxies_Click"/>
                                <Button Style="{StaticResource FlatButton}" Content="Clean Dead" Padding="11,6" Margin="6,0,0,0" FontSize="11.5" Click="BtnRemoveDeadProxies_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6,6,0,0" Padding="14,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.2*"/>
                            <ColumnDefinition Width="0.9*"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="0.8*"/>
                            <ColumnDefinition Width="65"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="PROXY" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="STATUS" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="EXIT IP" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="LOCATION" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="4" Text="PING" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="5" Text="DEL" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </Grid>
                </Border>

                <ListBox x:Name="ProxiesList" Grid.Row="2" Background="{StaticResource Surface}" Foreground="{StaticResource Text}"
                         BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,1,1"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" Padding="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="6,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.2*"/>
                                    <ColumnDefinition Width="0.9*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="0.8*"/>
                                    <ColumnDefinition Width="65"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding DisplayLabel}" Foreground="{StaticResource Text}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{StaticResource Green}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding ExitIp}" Foreground="{StaticResource Text}" FontSize="11.5" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="{Binding Country}" Foreground="{StaticResource Muted}" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="4" Text="{Binding Latency}" Foreground="{StaticResource Accent}" FontSize="11.5" VerticalAlignment="Center"/>
                                <Button Grid.Column="5" Style="{StaticResource FlatButton}" Padding="8,3" FontSize="11" Content="Del" HorizontalAlignment="Right" Click="BtnDeleteProxy_Click" Tag="{Binding}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- ======================= VPN VIEW ======================= -->
            <ScrollViewer x:Name="VpnView" Grid.Row="1" Margin="20,16" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="740" HorizontalAlignment="Left">
                    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="OPENVPN (.ovpn) - BUILT-IN PORTABLE ENGINE" Foreground="{StaticResource Accent}" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Text="Tip: For isolated per-profile OpenVPN (without changing your PC IP), assign your .ovpn inside Browser Profile settings." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,12"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtOvpnPath" Grid.Column="0" Style="{StaticResource DarkTextBox}"/>
                                <Button Grid.Column="2" Style="{StaticResource FlatButton}" Content="Browse .ovpn" Click="BtnBrowseOvpn_Click"/>
                                <Button Grid.Column="4" Style="{StaticResource GreenButton}" Content="Connect" Click="BtnConnectOvpn_Click"/>
                                <Button Grid.Column="6" Style="{StaticResource FlatButton}" Content="Stop" Click="BtnStopOvpn_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="WIREGUARD (.conf) - BUILT-IN PORTABLE ENGINE" Foreground="{StaticResource Accent}" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Text="Tip: For isolated per-profile WireGuard via wireproxy, assign your .conf inside Browser Profile settings." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,12"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtWgPath" Grid.Column="0" Style="{StaticResource DarkTextBox}"/>
                                <Button Grid.Column="2" Style="{StaticResource FlatButton}" Content="Browse .conf" Click="BtnBrowseWg_Click"/>
                                <Button Grid.Column="4" Style="{StaticResource GreenButton}" Content="Connect" Click="BtnConnectWg_Click"/>
                                <Button Grid.Column="6" Style="{StaticResource FlatButton}" Content="Stop" Click="BtnStopWg_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18">
                        <StackPanel>
                            <TextBlock Text="CURRENT PUBLIC IP, LOCATION &amp; TIMEZONE CHECK" Foreground="{StaticResource Accent}" FontSize="12" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Style="{StaticResource AccentButton}" Content="Check IP &amp; Timezone Now" Click="BtnCheckGlobalIp_Click"/>
                                <TextBlock x:Name="GlobalIpText" Text="Click to check active IP &amp; Timezone" Foreground="{StaticResource Muted}" FontSize="12.5" VerticalAlignment="Center" Margin="14,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ======================= CLOUD SYNC (CLOUDFLARE R2) VIEW ======================= -->
            <ScrollViewer x:Name="CloudView" Grid.Row="1" Margin="20,16" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="740" HorizontalAlignment="Left">
                    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="CLOUDFLARE R2 - END-TO-END AES-256 ENCRYPTED SYNC" Foreground="{StaticResource Accent}" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Text="All profiles, cookies, bookmarks, sessions &amp; proxies are encrypted locally with AES-256 before uploading to your private R2 bucket."
                                       Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,14"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="S3 Endpoint URL (https://&lt;ACCOUNT_ID&gt;.r2.cloudflarestorage.com)" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtR2Endpoint" Style="{StaticResource DarkTextBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Bucket Name" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtR2Bucket" Style="{StaticResource DarkTextBox}"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Access Key ID" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtR2AccessKey" Style="{StaticResource DarkTextBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Secret Access Key" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtR2SecretKey" Style="{StaticResource DarkTextBox}"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Sync Encryption Password (must match across all your PCs)" Foreground="{StaticResource Accent}" FontSize="11.5" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtR2Password" Style="{StaticResource DarkTextBox}" Margin="0,0,0,12"/>

                            <CheckBox x:Name="ChkR2AutoSync" Content="Auto-Sync profile to Cloudflare R2 automatically whenever a browser window closes"
                                      Foreground="{StaticResource Text}" FontSize="12" Margin="0,0,0,14"/>

                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource AccentButton}" Content="Save &amp; Test Connection" Padding="14,7" Click="BtnR2SaveTest_Click"/>
                                <Button Style="{StaticResource GreenButton}" Content="Push All to Cloud" Padding="14,7" Margin="8,0,0,0" Click="BtnR2PushAll_Click"/>
                                <Button Style="{StaticResource FlatButton}" Content="Pull All from Cloud" Padding="14,7" Margin="8,0,0,0" Click="BtnR2PullAll_Click"/>
                            </StackPanel>

                            <TextBlock x:Name="R2StatusText" Text="Enter your Cloudflare R2 credentials above and click Save &amp; Test Connection."
                                       Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Status Bar -->
            <Border Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="16,0">
                    <TextBlock x:Name="StatusText" Text="MH Advanced Tool v4.4 ready." FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
