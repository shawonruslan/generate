<Window x:Class="MHBrowser.DarkDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MH Advanced Tool" Icon="pack://application:,,,/app.ico"
        Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Foreground="{StaticResource Text}" FontFamily="Segoe UI">
    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.55" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource Panel}" CornerRadius="10,10,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="Header_MouseDown">
                <Grid Margin="16,0,10,0">
                    <TextBlock x:Name="TitleText" Text="Notice" Foreground="{StaticResource Text}" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button x:Name="BtnX" Style="{StaticResource ToolbarIconButton}" Width="26" Height="26" HorizontalAlignment="Right" VerticalAlignment="Center" Content="&#x2715;" FontSize="11" Click="BtnNo_Click"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="18,16">
                <TextBlock x:Name="MessageText" Text="" Foreground="{StaticResource Text}" FontSize="12.5" TextWrapping="Wrap" LineHeight="19" MaxHeight="260"/>
                <TextBox x:Name="InputBox" Style="{StaticResource DarkTextBox}" Margin="0,12,0,0" Visibility="Collapsed" KeyDown="InputBox_KeyDown"/>
                <ProgressBar x:Name="BusyBar" Height="4" Margin="0,14,0,0" IsIndeterminate="True" Visibility="Collapsed"
                             Foreground="{StaticResource Accent}" Background="{StaticResource PanelAlt}" BorderThickness="0"/>
            </StackPanel>

            <StackPanel x:Name="FooterPanel" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="18,0,18,16">
                <Button x:Name="BtnPrimary" Style="{StaticResource AccentButton}" Content="OK" MinWidth="88" Click="BtnYes_Click"/>
                <Button x:Name="BtnSecondary" Style="{StaticResource FlatButton}" Content="Cancel" MinWidth="84" Margin="8,0,0,0" Visibility="Collapsed" Click="BtnNo_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
